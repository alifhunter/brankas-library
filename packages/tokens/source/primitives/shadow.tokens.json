{
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "0px",
          "color": "rgba(0,0,0,0.06)"
        },
        {
          "offsetX": "0px",
          "offsetY": "-1px",
          "blur": "1px",
          "spread": "0px",
          "color": "rgba(0,0,0,0.02)"
        }
      ]
    },
    "md": {
      "$value": {
        "offsetX": "10px",
        "offsetY": "10px",
        "blur": "30px",
        "spread": "0px",
        "color": "rgba(174,174,192,0.25)"
      }
    },
    "lg": {
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "6px",
          "spread": "-2px",
          "color": "rgba(16,24,40,0.03)"
        },
        {
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "16px",
          "spread": "-4px",
          "color": "rgba(16,24,40,0.08)"
        }
      ]
    },
    "mobile": {
      "selection": {
        "$value": "{shadow.md}",
        "$description": "Selection card. Subtle directional drop matching shadow.md (AEAEC0 25%)."
      },
      "button": {
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "-1px",
            "blur": "0.5px",
            "spread": "0px",
            "color": "rgba(0,0,0,0.02)"
          },
          {
            "offsetX": "0px",
            "offsetY": "4px",
            "blur": "4px",
            "spread": "0px",
            "color": "rgba(0,0,0,0.06)"
          }
        ],
        "$description": "Button (raised pills). Two layers: hairline top edge (2%) + soft bottom drop (6%). Used by tertiary-invert variant on light surfaces."
      },
      "bottomNav": {
        "$value": {
          "offsetX": "10px",
          "offsetY": "10px",
          "blur": "34px",
          "spread": "0px",
          "color": "rgba(115,115,115,0.82)"
        },
        "$description": "Bottom navigation. Heavy gray shadow to lift the tab bar above content."
      },
      "collapsiblePanel": {
        "$value": {
          "offsetX": "4px",
          "offsetY": "-10px",
          "blur": "8px",
          "spread": "0px",
          "color": "rgba(174,174,192,0.12)"
        },
        "$description": "Collapsible panel (e.g. Summary Portfolio). Upward-cast shadow for a panel rising from below."
      },
      "bottomNavQris": {
        "$value": {
          "offsetX": "0px",
          "offsetY": "4.8px",
          "blur": "7.2px",
          "spread": "0px",
          "color": "rgba(195,50,42,0.5)"
        },
        "$description": "QRIS floating button on the bottom navigation. Red glow that matches the QRIS gradient."
      }
    }
  }
}
